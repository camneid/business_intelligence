set.seed(42)
n <- 100
# 1. Exact collinearity
x2 <- runif(n, min = 10, max = 100)
x1 <- 2.2 * x2
y <- 5 + 1.5 * x2 + rnorm(n, mean = 0, sd = 2)
# Step 1: Regress Y on X1
step1 <- lm(y ~ x1)
residuals.1 <- step1$residuals
# Step 2: Regress X2 on X1
step2 <- lm(x2 ~ x1)
residuals.2 <- step2$residuals
# FIX: Clean floating-point precision noise from R's memory
residuals.2 <- zapsmall(residuals.2)
# Step 3: Plot
plot(
residuals.1 ~ residuals.2,
xlab = "e-hat from X2 on X1",
ylab = "e-hat from Y on X1",
main = "Added Variable Plot (Perfect Collinearity)",
xlim = c(-1, 1) # Set x-limits so you can clearly see the vertical line at 0
)
# Reference line strictly at x = 0
abline(v = 0, col = "red", lty = 2, lwd = 2)
# 1. Generate synthetic data where Y = 3*X1 exactly, and X1, X2 are not perfectly correlated
set.seed(42)
n <- 100
# X1 and X2 generated independently (not perfectly correlated)
x1 <- runif(n, min = 1, max = 50)
x2 <- runif(n, min = 10, max = 100)
# Y depends purely on X1 with no error (Y = 3*X1)
y <- 3 * x1
# Step 1: Regress Y on X1 and get residuals
step1 <- lm(y ~ x1)
residuals.1 <- step1$residuals
# Clean potential floating-point precision artifacts from R
residuals.1 <- zapsmall(residuals.1)
# Step 2: Regress X2 on X1 and get residuals
step2 <- lm(x2 ~ x1)
residuals.2 <- step2$residuals
# Step 3: Added Variable Plot
plot(
residuals.1 ~ residuals.2,
xlab = "e-hat from X2 on X1",
ylab = "e-hat from Y on X1",
main = "Added Variable Plot for X2 given X1 (Y = 3*X1 exactly)",
ylim = c(-1, 1), # Set y-limits to clearly see the points along y = 0
pch = 19,
col = "blue"
)
# Reference horizontal line at y = 0
abline(h = 0, col = "red", lty = 2, lwd = 2)
# Fitted regression line (will be perfectly horizontal)
abline(lm(residuals.1 ~ residuals.2), col = "black", lwd = 2)
# 1. Generate synthetic data where X1 is independent (uncorrelated) to X2 and Y
set.seed(42)
n <- 100
x1 <- rnorm(n, mean = 0, sd = 1)
x2 <- rnorm(n, mean = 50, sd = 10)
# Orthogonalize x1 relative to x2 to ensure sample covariance is exactly 0
x1 <- x1 - (cov(x1, x2) / var(x2)) * (x2 - mean(x2))
# Generate Y dependent purely on X2
y <- 10 + 2 * x2 + rnorm(n, mean = 0, sd = 5)
# Orthogonalize Y relative to X1
y <- y - (cov(y, x1) / var(x1)) * (x1 - mean(x1))
# 2. Compute Residuals for Added-Variable Plot
res_y_x1 <- residuals(lm(y ~ x1))
res_x2_x1 <- residuals(lm(x2 ~ x1))
# 3. Plot side-by-side
par(mfrow = c(1, 2))
# Left Plot: Marginal Plot (Y vs X2)
plot(y ~ x2, main = "Marginal Plot: Y vs X2",
xlab = "X2", ylab = "Y", pch = 19, col = "blue")
abline(lm(y ~ x2), col = "red", lwd = 2)
# Right Plot: Added Variable Plot
plot(res_y_x1 ~ res_x2_x1, main = "Added Variable Plot",
xlab = "e-hat from X2 on X1", ylab = "e-hat from Y on X1",
pch = 19, col = "blue")
abline(lm(res_y_x1 ~ res_x2_x1), col = "red", lwd = 2)
par(mfrow = c(1, 1))
