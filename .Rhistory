# 1. Generate synthetic data with perfect collinearity
set.seed(42)
n <- 100
# x2 is weight in kg, x1 is weight in lbs (exact linear relationship)
x2 <- runif(n, min = 10, max = 100)
x1 <- 2.2 * x2
# Generate outcome Y with some random noise
y <- 5 + 1.5 * x2 + rnorm(n, mean = 0, sd = 2)
# Step 1: Regress Y on X1 and get residuals
step1 <- lm(y ~ x1)
residuals.1 <- step1$residuals
# Step 2: Regress X2 on X1 and get residuals
step2 <- lm(x2 ~ x1)
residuals.2 <- step2$residuals
# Step 3: Added Variable Plot
plot(
residuals.1 ~ residuals.2,
xlab = "e-hat from X2 on X1",
ylab = "e-hat from Y on X1",
main = "Added Variable Plot for X2 given X1"
)
abline(lm(residuals.1 ~ residuals.2), lwd = 2)
# 1. Generate synthetic data with perfect collinearity
set.seed(42)
n <- 100
# x2 is weight in kg, x1 is weight in lbs (exact linear relationship)
